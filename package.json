{
  "name": "firesighter",
  "version": "1.0.0",
  "private": true,
  "description": "Camera-first community fire reporting and incident verification portal",
  "type": "commonjs",
  "scripts": {
    "dev": "node backend/server.js",
    "dev:cloud": "vite",
    "start": "node backend/server.js",
    "preview": "vite preview",
    "seed": "node scripts/seed-demo-data.js",
    "smoke:worker": "node scripts/smoke-worker.mjs",
    "check": "node --check backend/server.js && node --check frontend/app.js",
    "types:worker": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_WRITE_LOGS=false wrangler types --config wrangler.jsonc",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "test": "node --test --test-reporter=spec",
    "build:local": "npm run check && npm test",
    "build": "npm run check && npm test && npm run typecheck:worker && vite build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.18.3"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260910.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  }
}
